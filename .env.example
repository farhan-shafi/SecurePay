# Copy this file to `.env` before running `docker compose up`.
# docker compose automatically reads `.env` for ${VARIABLE} substitution.

# Postgres credentials (used by the postgres container AND the services).
POSTGRES_USER=securepay
POSTGRES_PASSWORD=securepay_dev_password
POSTGRES_DB=securepay

# Secret used to sign JWT access/refresh tokens.
# In production this must be a long, random, secret string.
JWT_SECRET=dev-secret-change-me-to-a-long-random-string

# RabbitMQ credentials (used by the rabbitmq container AND the services that
# publish/consume events). The built-in `guest` account only works from
# localhost, so we set an explicit user that works across the Docker network.
RABBITMQ_USER=securepay
RABBITMQ_PASSWORD=securepay_dev_password

# Email sending via Brevo (optional). Leave BREVO_API_KEY empty to just log
# emails instead of sending them. To send for real: create a free Brevo account,
# verify a sender email, then make an API key (Settings -> SMTP & API -> API Keys).
BREVO_API_KEY=
EMAIL_SENDER=your-verified-sender@example.com
EMAIL_SENDER_NAME=SecurePay
